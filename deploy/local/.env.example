MYSQL_PORT=3306
MYSQL_DATABASE=pf_nl2sql
MYSQL_USER=nl2sql_app
# 仅用于本机 Docker 开发环境；不要用于共享或生产环境。
MYSQL_PASSWORD=nl2sql_local_app_password
