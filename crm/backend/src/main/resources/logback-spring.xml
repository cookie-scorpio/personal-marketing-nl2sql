<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <springProperty scope="context" name="SQL_LOG_DIR" source="app.query.sql-log-dir" defaultValue="logs"/>
  <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${SQL_LOG_DIR}/sql-review.log</file>
    <encoder><charset>UTF-8</charset><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %msg%n</pattern></encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${SQL_LOG_DIR}/sql-review.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>20MB</maxFileSize><maxHistory>14</maxHistory><totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>
  <logger name="SQL_REVIEW" level="INFO" additivity="false"><appender-ref ref="SQL_FILE"/></logger>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
